---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/' | absolute_url }}"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {% assign lessons = site.pages | where: "layout", "lesson" | sort: "date" | reverse %}
  {% for lesson in lessons %}
  <entry>
    <title>{{ lesson.number }} · {{ lesson.title | xml_escape }}</title>
    <link href="{{ lesson.url | absolute_url }}"/>
    <id>{{ lesson.url | absolute_url }}</id>
    <published>{{ lesson.date | date_to_xmlschema }}</published>
    <updated>{{ lesson.last_verified | default: lesson.date | date_to_xmlschema }}</updated>
    <summary>{{ lesson.summary | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
